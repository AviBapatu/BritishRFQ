  <diagram id="04ysFvDY9RSPS_6DSFvz" name="Page-2">
    <mxGraphModel dx="1997" dy="1223" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5000" pageHeight="5000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Supplier as React Client (Supplier)\n    participant API as FastAPI Router\n    participant Engine as Auction Engine\n    participant DAL as Data Access Layer\n    participant DB as PostgreSQL\n    participant Worker as Background Worker\n    participant WS as WebSocket Manager\n\n    Supplier-&gt;&gt;API: POST /bids (freight, origin, dest)\n    API-&gt;&gt;Engine: Validate Payload &amp; Initiate Process\n    \n    Engine-&gt;&gt;DAL: Request DB Transaction\n    DAL-&gt;&gt;DB: BEGIN\n    DAL-&gt;&gt;DB: SELECT * FROM rfqs WHERE id = X FOR UPDATE\n    Note over DAL, DB: Row is now locked. Other bids wait here.\n    \n    DAL-&gt;&gt;DB: INSERT INTO bids (charges, total_value)\n    DAL-&gt;&gt;DB: Execute Window Function to calculate Ranks\n    DB--&gt;&gt;DAL: Return new Bid &amp; current Ranks\n    DAL-&gt;&gt;DB: COMMIT (Unlock row)\n    DAL--&gt;&gt;Engine: Return state to Engine\n    \n    Engine-&gt;&gt;Engine: Evaluate British Auction Rules (Time &amp; Rank)\n    \n    alt If extension triggered (e.g., L1 changed in last X mins)\n        Engine-&gt;&gt;Worker: Cancel closure task for HH:MM\n        Engine-&gt;&gt;Worker: Spawn new closure task for HH:MM + Y mins\n    end\n\n    Engine-&gt;&gt;WS: Broadcast Delta (Rank Change / Time Ext)\n    WS--&gt;&gt;Supplier: Emit JSON {\&quot;event\&quot;: \&quot;RANK_UPDATE\&quot;, ...}\n    \n    Engine--&gt;&gt;API: Process Complete\n    API--&gt;&gt;Supplier: 201 Created (Success)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wg224WKbWw1efkCJuaMR-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
